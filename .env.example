# Конфиг веб-приложения Firebase (проект binder-54fb1). Скопируй в .env и заполни.
# Это не секрет: значения всё равно попадают в код расширения, доступ защищают правила Firestore.
# Но в git их не кладём: сканеры секретов принимают apiKey за утечку.
# Значения выдаёт Firebase CLI:
#   firebase apps:sdkconfig web 1:934060415328:web:c87638a6629ae6c119e605 --project binder-54fb1
WXT_FIREBASE_API_KEY=
WXT_FIREBASE_AUTH_DOMAIN=
WXT_FIREBASE_PROJECT_ID=
WXT_FIREBASE_STORAGE_BUCKET=
WXT_FIREBASE_MESSAGING_SENDER_ID=
WXT_FIREBASE_APP_ID=
