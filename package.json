{
  "name": "binder",
  "description": "Закрытый клуб коллекционеров Pokémon TCG: цифровой альбом настоящих карточек",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "wxt prepare",
    "test:rules": "firebase emulators:exec --only firestore --project demo-binder \"vitest run --config vitest.rules.config.ts\"",
    "test:live": "vitest run --config vitest.live.config.ts",
    "prices:build": "vite build --config scripts/vite.config.ts",
    "prices:refresh": "npm run prices:build && node .output/scripts/refresh-prices.mjs"
  },
  "dependencies": {
    "@fontsource/onest": "5.3.1",
    "@fontsource/press-start-2p": "5.3.0",
    "@fontsource/rubik": "5.3.0",
    "firebase": "13.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "wouter": "3.13.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@wxt-dev/module-react": "1.2.2",
    "firebase-admin": "14.5.0",
    "firebase-tools": "15.35.0",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "wxt": "0.21.5"
  },
  "allowScripts": {
    "@firebase/util": false,
    "protobufjs": false,
    "re2": false
  }
}
